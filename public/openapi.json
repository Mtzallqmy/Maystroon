                "type": "string"
              }
            }
          }
        }
      },
      "Command": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": ["string", "null"],
            "format": "uuid"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "patch": {
            "type": "object"
          },
          "action": {
            "type": "string"
          },
          "scheduled_at": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "transfer_to": {
            "type": ["string", "null"],
            "format": "uuid"
          },
          "items": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "object"
            }
          }
        }
      },
      "RichDocument": {
        "type": "object",
        "required": ["type", "content"],
        "properties": {
          "type": {
            "const": "doc"
          },
          "content": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "Supabase SSR session",
        "description": "Project-dependent HttpOnly cookie; exact configured Origin required for writes."
      },
      "cronBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
