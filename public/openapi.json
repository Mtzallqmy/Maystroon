                    "type": "string",
                    "minLength": 1,
                    "maxLength": 5000,
                    "description": "Plain text; HTTP links and HTML rejected"
                  },
                  "parent_id": {
                    "type": ["string", "null"],
                    "format": "uuid"
                  },
                  "website": {
                    "const": ""
                  }
                }
              }
            }
          }
